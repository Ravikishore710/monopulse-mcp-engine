# Runtime Server & Environment Configuration
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"
DISABLE_HMR="false"
VITEST="false"

# Simulation & Test Isolation Flag (forces deterministic sandbox mode when "true")
MONOPULSE_FORCE_SIMULATION="false"

# Optional Error Tracking & Observability (Sentry DSN; falls back to pino structured logs when empty)
SENTRY_DSN=""

# GEMINI_API_KEY: Required for Gemini AI API calls (reasoning + gemini-embedding-2-preview)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this MonoPulse instance is hosted
APP_URL="http://localhost:3000"

# Cryptographic Webhook & Approval Signing Secrets (HMAC-SHA256 + Keyring Rotation)
MONOPULSE_WEBHOOK_SECRET="replace-with-hmac-sha256-webhook-secret"
MONOPULSE_APPROVAL_SECRET="replace-with-hmac-sha256-approval-secret"
MONOPULSE_PREVIOUS_SECRET="replace-with-rotated-previous-hmac-secret"

# Optional External Live MCP Connectors (automatic deterministic sandbox fallback when empty)
GITHUB_TOKEN=""
GITHUB_REPO="Ravikishore710/monopulse-mcp-engine"
SLACK_BOT_TOKEN=""
JIRA_API_TOKEN=""
JIRA_BASE_URL="https://your-org.atlassian.net"
JIRA_USER_EMAIL="operator@example.com"

# Optional ArgoCD & Kubernetes Control Plane Connector
ARGOCD_SERVER_URL="https://argocd.internal.example.com"
ARGOCD_AUTH_TOKEN=""

# Optional External Memory Adapters (defaults to embedded SQLite + pgvector + Redis engine if omitted)
POSTGRES_PGVECTOR_URL=""
REDIS_CACHE_URL=""

# Optional Kaggle MCP / GPU Offload Credentials for Playbook Extractor trajectory distillation
KAGGLE_USERNAME=""
KAGGLE_KEY=""
KAGGLE_GPU_KERNEL_SLUG="monopulse-ops/trajectory-playbook-distiller-gpu"
