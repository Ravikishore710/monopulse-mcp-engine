# GEMINI_API_KEY: Required for Gemini AI API calls (reasoning + gemini-embedding-2-preview).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Memory Adapters (defaults to embedded pgvector + Redis engine if omitted)
POSTGRES_PGVECTOR_URL=""
REDIS_CACHE_URL=""

# Optional Kaggle MCP / GPU Offload Credentials for Playbook Extractor trajectory distillation
KAGGLE_USERNAME=""
KAGGLE_KEY=""
KAGGLE_GPU_KERNEL_SLUG="monopulse-ops/trajectory-playbook-distiller-gpu"
