{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies", "security"],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchManagers": ["npm", "github-actions"],
      "enabled": true
    }
  ]
}
