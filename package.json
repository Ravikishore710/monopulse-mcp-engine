{
  "name": "monopulse-mcp-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx server.ts",
    "start": "NODE_NO_WARNINGS=1 tsx server.ts",
    "cli": "NODE_NO_WARNINGS=1 tsx cli.ts",
    "mcp:stdio": "NODE_NO_WARNINGS=1 tsx cli.ts --mcp-stdio",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:api": "NODE_NO_WARNINGS=1 vitest run tests/apiRoutes.test.ts tests/mcpProtocolAndObservability.test.ts tests/sqliteAndCrypto.test.ts tests/durableGovernanceAndNormalization.test.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src server.ts cli.ts --max-warnings=0",
    "lint:fix": "eslint --fix src server.ts cli.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vitest": "^5.0.5"
  }
}
